[Unit]
Description=PDR Calculator - Калькулятор ведения беременности
Documentation=https://github.com/pdr-calc
After=network.target
Wants=network-online.target

[Service]
Type=notify
User=www-data
Group=www-data
WorkingDirectory=/opt/pdr
Environment="PATH=/opt/pdr/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/opt/pdr/venv/bin/gunicorn --config /opt/pdr/gunicorn.conf.py wsgi:app
ExecReload=/bin/kill -s HUP $MAINPID
ExecStop=/bin/kill -s TERM $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/gunicorn /tmp
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pdr-calc

# Security hardening
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
SecureBits=noroot-locked

[Install]
WantedBy=multi-user.target